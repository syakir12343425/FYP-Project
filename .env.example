# Copy to .env  (NEVER commit .env)
JWT_SECRET=            # python -c "import secrets;print(secrets.token_urlsafe(64))"
# Supabase: Project Settings > Database > Connection string (use the pooler URI), append ?sslmode=require
# DATABASE_URL=postgresql+psycopg2://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./stego_auth.db
ALLOWED_ORIGINS=http://localhost:8080
COOKIE_SECURE=false    # true once served over HTTPS
ENV=dev                # prod hides /docs
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
