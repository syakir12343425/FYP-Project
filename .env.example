# Copy to .env  (NEVER commit .env)
JWT_SECRET=            # python -c "import secrets;print(secrets.token_urlsafe(64))"
# --- Database: exactly ONE DATABASE_URL line active ---
# Local development (default, no internet needed):
DATABASE_URL=sqlite:///./stego_auth.db
# Supabase OWNER - setup/admin tasks only (create_admin.py), never for the running server.
# Session pooler = port 5432 (not the 6543 transaction pooler). Always keep ?sslmode=require.
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<owner-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Supabase APP ROLE - what the server runs with. Generate with: python tools/make_db_role_secret.py
# DATABASE_URL=postgresql+psycopg2://stego_app.<project-ref>:<48-hex-chars>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
ALLOWED_ORIGINS=http://localhost:8080
COOKIE_SECURE=false    # true once served over HTTPS
ENV=dev                # prod hides /docs
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
# Two-step verification: encrypts authenticator secrets in the database. 32 random bytes, base64:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Keep it secret and backed up: losing it means every user must set up two-step verification again.
MFA_ENCRYPTION_KEY=
# Admins must turn on two-step verification before they can manage accounts (recommended: true)
REQUIRE_ADMIN_MFA=true

# Self sign-up: email confirmation, then two-step verification for everyone
ALLOW_SIGNUP=true
SIGNUP_REQUIRES_APPROVAL=false
REQUIRE_MFA_ALL=true
# Outgoing email: Gmail with an APP PASSWORD (Google Account > Security > App passwords), never your Gmail password.
# Leave empty during development (ENV=dev): emails are then printed in the server window.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
PUBLIC_URL=http://localhost:8080
