# /etc/caddy/Caddyfile for RobustStego. Replace SITE_ADDRESS with your domain (e.g. robuststego.example.com).
# Caddy gets and renews the HTTPS certificate automatically and redirects http -> https.
SITE_ADDRESS {
	encode zstd gzip

	# API: everything under /api goes to uvicorn on localhost. /docs and /openapi.json stay closed (ENV=prod).
	handle /api/* {
		request_body {
			max_size 12MB
		}
		reverse_proxy 127.0.0.1:8000
	}

	# The web app: only this folder is served (not the repo, not .env).
	handle {
		root * /opt/robuststego/app/fyp-stego-app
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	log {
		output file /var/log/caddy/robuststego.log
	}
}
